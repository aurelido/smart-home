# =============================================================================
# Casa Nórdica - Variables de entorno
# =============================================================================
# Copiar a .env y rellenar con valores reales:
#   cp .env.example .env
#
# IMPORTANTE: Nunca hacer commit del archivo .env
# =============================================================================

# --- Sistema ---
TZ=Europe/Madrid
PUID=1000
PGID=1000

# --- Red ---
NETWORK_MODE=host
HOST_IP=192.168.1.100

# --- Home Assistant ---
HA_IMAGE=ghcr.io/home-assistant/home-assistant
HA_TAG=2026.3
HA_CONTAINER_NAME=home-assistant
HA_PORT=8123
HA_CPU_LIMIT=2.0
HA_MEM_LIMIT=1g

# --- Mosquitto MQTT Broker ---
MQTT_IMAGE=eclipse-mosquitto
MQTT_TAG=2.0.21
MQTT_CONTAINER_NAME=mosquitto
MQTT_PORT=1883
MQTT_WS_PORT=9001
MQTT_CPU_LIMIT=0.5
MQTT_MEM_LIMIT=128m

# --- Credenciales MQTT ---
# Cada servicio tiene su propio usuario/contraseña para acceder al broker MQTT.
# Generar automáticamente con: ./scripts/generate-secrets.sh
#
# Usuario para Zigbee2MQTT (bridge Zigbee -> MQTT)
MQTT_USER_Z2M=zigbee2mqtt
MQTT_PASS_Z2M=CAMBIAR_generar_con_generate_secrets
#
# Usuario para Home Assistant (hub de automatización)
MQTT_USER_HA=homeassistant
MQTT_PASS_HA=CAMBIAR_generar_con_generate_secrets

# --- Zigbee2MQTT ---
Z2M_IMAGE=ghcr.io/koenkk/zigbee2mqtt
Z2M_TAG=2.1.1
Z2M_CONTAINER_NAME=zigbee2mqtt
Z2M_PORT=8080
Z2M_DEVICE=/dev/ttyACM0
Z2M_ADAPTER=ember
Z2M_NETWORK_KEY=GENERATE
Z2M_CPU_LIMIT=1.0
Z2M_MEM_LIMIT=512m

# --- Backups ---
BACKUP_DIR=/volume1/docker/smart-home/backups
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION=false

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=/volume1/docker/smart-home/logs
