# =============================================================================
# Casa Nórdica - Variables de entorno
# =============================================================================
# 1. Copiar este archivo:    cp .env.example .env
# 2. Generar contraseñas:    bash scripts/generate-secrets.sh --apply
# 3. Desplegar:              bash scripts/deploy.sh
#
# IMPORTANTE: Nunca hacer commit del archivo .env
# =============================================================================

# --- Zona horaria ---
TZ=Europe/Madrid

# --- IP del NAS ---
HOST_IP=192.168.1.100

# --- Dispositivo Zigbee (verificar con: dmesg | grep tty) ---
ZIGBEE_DEVICE=/dev/ttyACM0

# --- Home Assistant Access Token (para Matter Hub) ---
# Generar en HA: Perfil de usuario → Tokens de acceso → Crear token
HA_ACCESS_TOKEN=CAMBIAR_pegar_token_de_home_assistant

# --- Credenciales MQTT ---
# Generadas automáticamente por scripts/generate-secrets.sh
# Cada servicio tiene su propio usuario/contraseña
#
# Zigbee2MQTT (bridge Zigbee -> MQTT)
MQTT_USER_Z2M=zigbee2mqtt
MQTT_PASS_Z2M=CAMBIAR_generar_con_generate_secrets
#
# Home Assistant (hub de automatización)
MQTT_USER_HA=homeassistant
MQTT_PASS_HA=CAMBIAR_generar_con_generate_secrets
