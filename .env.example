# =============================================================================
# Smart Home - Variables de entorno
# =============================================================================
# Copiar a .env y rellenar con valores reales:
#   cp .env.example .env
#
# IMPORTANTE: Nunca hacer commit del archivo .env
# =============================================================================

# --- Zona horaria ---
TZ=Europe/Madrid

# --- Mosquitto MQTT ---
MQTT_USER_ZIGBEE2MQTT=zigbee2mqtt
MQTT_PASSWORD_ZIGBEE2MQTT=cambiar_contraseña_zigbee2mqtt

MQTT_USER_HOMEASSISTANT=homeassistant
MQTT_PASSWORD_HOMEASSISTANT=cambiar_contraseña_homeassistant

# --- Zigbee2MQTT ---
# Token de autenticación para el panel web (generar con: openssl rand -hex 32)
ZIGBEE2MQTT_AUTH_TOKEN=cambiar_token_autenticacion

# --- Ruta del adaptador Zigbee (verificar con: dmesg | grep tty en el NAS) ---
ZIGBEE_ADAPTER_PATH=/dev/ttyACM0
